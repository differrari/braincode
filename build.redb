@includeC("redbuild.h")

int main(int argc, strarr argv) {

    parse_arguments(argc,argv);
    rebuild_self(false);
    defer emit_compile_commands();
    
    if (global_target == target_none){ set_global_target(target_redacted); }
    
    if (not redbuild_run("~/uno")){ return 1; }

    new_module("braincode");
    set_name("braincode");
    
    set_package_type(package_red);
	ignore_source("build.c");
	ignore_source("brain.c");
	ignore_source("tree_layout.c");
    source_all("c");
    
    add_local_dependency("~/uno", "~/uno/uno.a", "~/uno", true);
    
    if (compile()){
        gen_compile_commands(0);
        if (global_target == native_target){
            run();
        } else {
            install("../../../applications");
            make_run("~/os","run");
        }
    }
}